# Kafka's host port. Read automatically by `docker compose` when run from this
# directory. Copy to ai-stack/.env (git-ignored).
#
# Must match KAFKA_BOOTSTRAP in dashboard/.env — the broker advertises this
# port to clients, so a mismatch sends them to the wrong address (on a shared
# VM, possibly another group's broker).
KAFKA_HOST_PORT=

# The Wazuh manager's log volume, which Filebeat reads the archive from:
# <wazuh compose project>_wazuh_logs. Empty = luckyfive_wazuh_wazuh_logs, which
# matches `docker compose -p luckyfive_wazuh`. Check: docker volume ls | grep wazuh_logs
WAZUH_LOGS_VOLUME=
