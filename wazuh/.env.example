# Host ports for the Wazuh stack + the indexer admin password.
# Read automatically by `docker compose` when run from this directory.
# Copy to wazuh/.env (git-ignored) and fill in.
#
# Defaults (1514/1515/514/55000/9200/443) are correct on a machine you own.
# On the shared SIAM VM another group's Wazuh may already hold them — a host
# port binds once regardless of container or project names. Check first:
#   ss -tlnp | grep -E ':(443|1514|1515|9200|55000)\b'
# Then pick free ports here. Container-side ports never change.

INDEXER_PASSWORD=

WAZUH_AGENT_PORT=
WAZUH_ENROLL_PORT=
WAZUH_SYSLOG_PORT=
WAZUH_API_PORT=
INDEXER_PORT=
DASHBOARD_PORT=
